{
  "manifest_version": 3,
  "name": "Ballon d'Or — Votes",
  "version": "1.0.1",
  "description": "Показывает рейтинг из ответов polls на ballondor.com.",
  "minimum_chrome_version": "111",
  "content_scripts": [
    {
      "matches": ["https://ballondor.com/*", "https://www.ballondor.com/*"],
      "js": ["ranking.js", "panel.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": ["https://ballondor.com/*", "https://www.ballondor.com/*"],
      "js": ["interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
